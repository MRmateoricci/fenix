{
  "name": "fenix-web",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "postinstall": "npm --prefix backend ci --no-audit --no-fund",
    "dev": "concurrently --kill-others-on-fail --names BACKEND,FRONTEND --prefix-colors yellow,cyan \"npm --prefix backend run dev\" \"npm run dev:frontend:ready\"",
    "dev:frontend": "vite",
    "dev:frontend:ready": "node scripts/waitForBackend.js && vite",
    "dev:backend": "npm --prefix backend run dev",
    "build": "vite build",
    "start": "npm --prefix backend start",
    "preview": "vite preview",
    "db:migrate": "npm --prefix backend run db:migrate",
    "db:seed": "npm --prefix backend run db:seed",
    "db:seed:demo": "npm --prefix backend run db:seed:demo"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.17.0",
    "soap": "^1.10.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.16"
  }
}
