# Puerto del servidor
PORT=3001

# Entorno de ejecución
NODE_ENV=development

# ----- Base de datos (Prisma + SQLite) -----
# Ruta al archivo SQLite — el directorio 'data/' se crea automáticamente
DATABASE_URL="file:./data/database.db"

# ----- OpenAI -----
# Sin esta clave, el sistema genera contenido de ejemplo (demo funciona igual)
OPENAI_API_KEY=

# ----- Meta Graph API -----
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_PAGE_ID=
META_INSTAGRAM_ACCOUNT_ID=
