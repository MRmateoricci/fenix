generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  name      String
  password  String
  role      String    @default("creator")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  accounts  Account[]

  @@map("users")
}

model Account {
  id           Int       @id @default(autoincrement())
  userId       Int?      @map("user_id")
  name         String
  platform     String
  username     String?
  pageId       String?   @map("page_id")
  accessToken  String?   @map("access_token")
  status       String    @default("disconnected")
  avatarColor  String    @default("#6366f1") @map("avatar_color")
  followers    Int       @default(0)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  user         User?     @relation(fields: [userId], references: [id])
  posts        Post[]
  brandProfile BrandProfile?

  @@map("accounts")
}

model Post {
  id           Int       @id @default(autoincrement())
  accountId    Int?      @map("account_id")
  platforms    String    @default("[]")
  imageUrl     String?   @map("image_url")
  caption      String?
  hashtags     String    @default("[]")
  scheduledAt  DateTime? @map("scheduled_at")
  publishedAt  DateTime? @map("published_at")
  status       String    @default("draft")
  metaPostId   String?   @map("meta_post_id")
  tone         String    @default("casual")
  niche        String    @default("general")
  prompt       String?
  errorMessage String?   @map("error_message")
  retryCount   Int       @default(0) @map("retry_count")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  account      Account?  @relation(fields: [accountId], references: [id])
  logs         PostLog[]

  @@map("posts")
}

model PostLog {
  id        Int      @id @default(autoincrement())
  postId    Int?     @map("post_id")
  action    String
  message   String?
  level     String   @default("info")
  createdAt DateTime @default(now()) @map("created_at")
  post      Post?    @relation(fields: [postId], references: [id])

  @@map("post_logs")
}

model BrandProfile {
  id              Int       @id @default(autoincrement())
  accountId       Int       @unique @map("account_id")
  visualStyle     String    @default("{}") @map("visual_style")
  contentThemes   String    @default("[]") @map("content_themes")
  toneVoice       String    @default("{}") @map("tone_voice")
  typicalHashtags String    @default("[]") @map("typical_hashtags")
  sampleCaptions  String    @default("[]") @map("sample_captions")
  referenceImages String    @default("[]") @map("reference_images")
  postsAnalyzed   Int       @default(0) @map("posts_analyzed")
  analyzedAt      DateTime? @map("analyzed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  account         Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("brand_profiles")
}
