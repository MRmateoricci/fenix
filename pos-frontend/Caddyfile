{
	# TLS lo termina el proxy de Railway; Caddy solo sirve HTTP en el puerto asignado.
	auto_https off
	admin off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	header {
		# El POS es una herramienta interna: que ningún buscador lo indexe.
		X-Robots-Tag "noindex, nofollow"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Los `handle` son excluyentes y van en orden. Hacen falta (en vez de
	# directivas sueltas) porque Caddy ejecuta `try_files` antes que `respond`:
	# suelto, el fallback ya habría reescrito /api/... a index.html.

	# Si el build salió con una VITE_API_URL equivocada, las llamadas a la API
	# llegarían acá. Sin esto el fallback devolvería index.html con 200 y el error
	# se vería como "Error de red" sin pistas; con 404 se ve en la consola.
	handle /api/* {
		respond "No hay API en este dominio" 404
	}

	# Los archivos de /assets llevan hash en el nombre: nunca cambian. Un asset
	# que no existe (típico justo después de un deploy) da 404, no index.html, y
	# ese 404 NO lleva el cache inmutable: si no, un navegador podría recordar por
	# un año que el archivo "no existe".
	handle /assets/* {
		@existe file
		header @existe Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Todo lo demás es la app. index.html sin cache, así un deploy nuevo se ve al
	# recargar la pestaña; y las rutas de React Router (/caja, /admin/panel-iva…)
	# caen en index.html, así refrescar no da 404.
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
