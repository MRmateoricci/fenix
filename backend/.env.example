PORT=3001
NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/fenix_db

# MercadoPago — obtener en https://www.mercadopago.com.ar/developers/panel/credentials
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxx
MP_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxx

# Contraseña administrativa validada solamente en el backend.
ADMIN_SECRET=cambiame-por-una-contrasena-segura
# Secreto independiente para firmar la cookie HTTP-only de 8 horas del panel.
ADMIN_SESSION_SECRET=cambiame-por-otra-cadena-aleatoria-larga

# Opcional. Sal para el hash anónimo de visitantes en la analítica de visitas
# (tabla page_views). Si falta, se usa ADMIN_SESSION_SECRET. Cambiarla borra la
# continuidad de "visitantes únicos" del día en curso, nada más.
ANALYTICS_SALT=

# Secreto para firmar los JWT de sesión de clientes (usar una cadena aleatoria larga en prod)
JWT_SECRET=cambiame-por-una-cadena-aleatoria-larga

# Acceso social. Las URLs de retorno que deben registrarse en cada proveedor son:
#   {APP_BASE_URL}/api/auth/oauth/google/callback
#   {APP_BASE_URL}/api/auth/oauth/facebook/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Places API (New) — reseñas reales de la ficha de Google Maps del local.
# Habilitar Places API (New) en Google Cloud y restringir esta clave al backend.
GOOGLE_PLACES_API_KEY=

# URLs de la app. En Railway, APP_BASE_URL y FRONTEND_BASE_URL usan el mismo
# dominio porque Express sirve frontend y backend desde un único servicio.
# En desarrollo se puede usar ngrok en APP_BASE_URL para recibir webhooks y
# como puente público para las URLs de retorno (Mercado Pago rechaza localhost).
APP_BASE_URL=http://localhost:3001
FRONTEND_BASE_URL=http://localhost:5173

# Carpeta donde se guardan las fotos de producto subidas por el admin.
# Por defecto usa ./public/uploads dentro de backend/ (sirve para desarrollo).
# En Railway/Render: montar un volumen persistente en esta misma ruta, si no
# las fotos se pierden en cada deploy.
UPLOADS_DIR=./public/uploads
# Volumen persistente privado; nunca debe estar dentro de UPLOADS_DIR.
TRANSFER_PROOFS_DIR=./private/transfer-proofs

# Backups completos cifrados (PostgreSQL + uploads + comprobantes). La clave
# debe tener al menos 32 caracteres y debe conservarse fuera del servidor: sin
# ella no se pueden recuperar los archivos .fenix.
BACKUPS_DIR=./private/backups
BACKUP_ENCRYPTION_KEY=
# Opcionales si PostgreSQL no está en PATH (por ejemplo, rutas a .exe en Windows).
PG_DUMP_PATH=pg_dump
PSQL_PATH=psql
# Límite para una restauración subida desde el panel (10 GiB por defecto).
BACKUP_MAX_UPLOAD_BYTES=10737418240

# El tarifario temporal es el proveedor predeterminado. Cuando esté lista la
# integración, cambiar a correo_argentino después de implementar el adaptador
# de backend/services/shippingQuotes.js.
SHIPPING_PROVIDER=manual

# Correo Argentino — API de cotización de costos y tiempos (pendiente de
# credenciales). La tienda funciona sin estos datos con el tarifario manual.
CORREO_ARGENTINO_API_URL=
CORREO_ARGENTINO_CLIENT_ID=
CORREO_ARGENTINO_CLIENT_SECRET=

# Gmail SMTP para confirmaciones de pedidos, verificación de cuentas e
# invitaciones a dejar reseñas. GMAIL_USER es la cuenta de Gmail/Google
# Workspace del local; GMAIL_APP_PASSWORD es una
# "contraseña de aplicación" generada en https://myaccount.google.com/apppasswords
# (requiere 2FA activado en esa cuenta — no es la contraseña normal).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# A qué mail le llega el aviso de pedido/reserva nuevo (puede ser el mismo GMAIL_USER)
ADMIN_NOTIFICATION_EMAIL=

# ARCA WSAA + WSFEv1. Las consultas son seguras en ambos ambientes; la emisión
# productiva queda bloqueada por defecto.
ARCA_ENV=homologation
# Este flag habilita exclusivamente FECAESolicitar en produccion. Mantener
# false hasta confirmar formalmente la habilitacion fiscal real de Fenix.
ARCA_PRODUCTION_ENABLED=false
# Habilita el intento inmediato después de pagos approved. Mantener false hasta
# probar manualmente el ambiente y el punto de venta correspondiente.
ARCA_AUTO_INVOICE_ENABLED=false
# Opt-in local: evita consultar catálogos ARCA durante el checkout. Sólo tiene
# efecto con NODE_ENV=development; ausente o false conserva el flujo normal.
ARCA_DEV_MOCK_ENABLED=false
ARCA_CUIT=
ARCA_PTO_VTA=
# El certificado debe corresponder al ambiente elegido y tener autorizado tanto
# `wsfe` como `ws_sr_constancia_inscripcion` en el Administrador de Relaciones.
# Railway/hosting: cargar ambos contenidos completos codificados en Base64 como
# secretos. Cuando existen, tienen prioridad sobre las rutas locales siguientes.
ARCA_CERT_BASE64=
ARCA_KEY_BASE64=
# Desarrollo local: archivos ignorados por Git. No subir certificados ni claves.
ARCA_CERT_PATH=./config/arca/arca_certificate.crt
ARCA_KEY_PATH=./config/arca/arca_private.key
ARCA_DEFAULT_CONCEPTO=1
ARCA_LEGAL_NAME=
ARCA_TAX_ADDRESS=
ARCA_TAX_CONDITION=Responsable Inscripto
# Obligatorio si ARCA_TAX_CONDITION=Responsable Inscripto. No tiene valor por
# defecto: verificar la habilitacion real y usar exactamente uno de:
# standard | cbu_informed | subject_to_withholding
ARCA_A_AUTHORIZATION_MODE=
ARCA_IIBB=
# Usar el PERIODO DESDE registral: YYYY-MM. También admite YYYY-MM-DD si ARCA
# informara oficialmente el día; no completar el día por inferencia.
ARCA_ACTIVITY_START_DATE=2024-01
# Opcional: ruta absoluta a openssl cuando no está en PATH.
ARCA_OPENSSL_PATH=
